{
  "$schema": "https://firebase.google.com/schemas/firestore-blueprint.json",
  "collections": [
    {
      "name": "frames",
      "description": "Collection of eyewear frames/glasses",
      "fields": [
        { "name": "name", "type": "string" },
        { "name": "brand", "type": "string" },
        { "name": "price", "type": "number" },
        { "name": "images", "type": "array" },
        { "name": "description", "type": "string" },
        { "name": "category", "type": "string" },
        { "name": "featured", "type": "boolean" },
        { "name": "tags", "type": "array" },
        { "name": "frameShape", "type": "string" },
        { "name": "frameColor", "type": "string" },
        { "name": "material", "type": "string" },
        { "name": "gender", "type": "string" },
        { "name": "inStock", "type": "boolean" },
        { "name": "createdAt", "type": "timestamp" }
      ],
      "rules": {
        "read": "true",
        "create": "true",
        "update": "true",
        "delete": "true"
      }
    },
    {
      "name": "stories",
      "description": "Short video/photo stories showcasing glasses",
      "fields": [
        { "name": "title", "type": "string" },
        { "name": "mediaUrl", "type": "string" },
        { "name": "mediaType", "type": "string" },
        { "name": "thumbnailUrl", "type": "string" },
        { "name": "duration", "type": "number" },
        { "name": "createdAt", "type": "timestamp" },
        { "name": "order", "type": "number" },
        { "name": "frameId", "type": "string" },
        { "name": "brand", "type": "string" }
      ],
      "rules": {
        "read": "true",
        "create": "true",
        "update": "true",
        "delete": "true"
      }
    },
    {
      "name": "brands",
      "description": "Optical brands showcase",
      "fields": [
        { "name": "name", "type": "string" },
        { "name": "logoUrl", "type": "string" },
        { "name": "country", "type": "string" },
        { "name": "order", "type": "number" },
        { "name": "createdAt", "type": "timestamp" }
      ],
      "rules": {
        "read": "true",
        "create": "true",
        "update": "true",
        "delete": "true"
      }
    },
    {
      "name": "orders",
      "description": "Customer frame orders",
      "fields": [
        { "name": "customerName", "type": "string" },
        { "name": "phone", "type": "string" },
        { "name": "address", "type": "string" },
        { "name": "wilaya", "type": "string" },
        { "name": "commune", "type": "string" },
        { "name": "items", "type": "array" },
        { "name": "status", "type": "string" },
        { "name": "totalAmount", "type": "number" },
        { "name": "createdAt", "type": "timestamp" }
      ],
      "rules": {
        "read": "true",
        "create": "true",
        "update": "true",
        "delete": "true"
      }
    },
    {
      "name": "settings",
      "description": "Store branding logo, shape, text visibility, and integration tokens",
      "fields": [
        { "name": "logoUrl", "type": "string" },
        { "name": "logoShape", "type": "string" },
        { "name": "showStoreName", "type": "boolean" },
        { "name": "showStoreSubtitle", "type": "boolean" },
        { "name": "storeName", "type": "string" },
        { "name": "storeSubtitle", "type": "string" },
        { "name": "uploadthingToken", "type": "string" },
        { "name": "updatedAt", "type": "string" }
      ],
      "rules": {
        "read": "true",
        "create": "true",
        "update": "true",
        "delete": "true"
      }
    }
  ]
}
